{
  "name": "date-solution",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Invitation app: Vue 3 client + Netlify Functions (TypeScript) + Cloudflare R2 storage",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "netlify dev --offline --filter @date-solution/frontend",
    "dev:client": "npm run dev --workspace @date-solution/frontend",
    "build": "npm run build --workspace @date-solution/frontend",
    "preview": "npm run preview --workspace @date-solution/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "netlify-cli@27.5.2": true,
    "sharp@0.34.5": true
  },
  "devDependencies": {
    "netlify-cli": "^27.5.2"
  }
}
