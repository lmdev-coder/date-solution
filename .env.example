# SHA-256 хеш пароля (hex). Сгенерировать: node -e "console.log(require('crypto').createHash('sha256').update('МОЙ_ПАРОЛЬ').digest('hex'))"
PASSWORD_HASH=

# Cloudflare R2 (S3-compatible API)
# Endpoint выводится из R2_ACCOUNT_ID: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Имя бакета (без endpoint и без слэшей).
# Бакет общий для нескольких приложений; объекты пишутся в date-solution/answers/
R2_BUCKET_NAME=